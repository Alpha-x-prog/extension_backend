GEMINI_API_KEY=your_gemini_api_key_here
PORT=8080

# Выбор модели. Если не указано — используется gemini-2.5-flash-lite
# Доступные варианты:
# gemini-2.5-flash-lite   — быстрая, меньше нагружена (по умолчанию)
# gemini-2.5-flash        — умнее, чуть медленнее
# gemini-2.0-flash        — старая стабильная
# gemini-3-flash-preview  — новейшая preview
GEMINI_MODEL=gemini-2.5-flash-lite
